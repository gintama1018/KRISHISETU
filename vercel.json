{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/mock/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/css/(.*)",
      "dest": "frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "frontend/js/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "frontend/icons/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "frontend/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "frontend/sw.js"
    },
    {
      "src": "/home.html",
      "dest": "frontend/home.html"
    },
    {
      "src": "/advisory.html",
      "dest": "frontend/advisory.html"
    },
    {
      "src": "/market.html",
      "dest": "frontend/market.html"
    },
    {
      "src": "/register.html",
      "dest": "frontend/register.html"
    },
    {
      "src": "/profile.html",
      "dest": "frontend/profile.html"
    },
    {
      "src": "/dashboard.html",
      "dest": "frontend/dashboard.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}

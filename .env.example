# KrishiSetu — Environment Variables Template
# Copy this file to .env and fill in your keys

# ─── AI Advisory ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Voice / TTS ──────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# ─── WhatsApp Delivery ────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Data Sources (all free/open — keys optional) ─────────────
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
AGMARKNET_BASE_URL=https://agmarknet.gov.in

# ─── AgriStack (mock sandbox) ─────────────────────────────────
AGRISTACK_SANDBOX_URL=http://localhost:8000/mock/agristack
AGRISTACK_API_KEY=mock_key_for_demo

# ─── Security ─────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_secret_key_32chars
ENCRYPTION_KEY=change_this_to_a_32byte_fernet_key

# ─── App Config ───────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=./krishisetu.db
